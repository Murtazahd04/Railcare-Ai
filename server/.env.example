# =============================================================================
# SRLMS — Environment Configuration Template
# =============================================================================
# Copy this file to server/.env and replace placeholder values with your new keys.
# NEVER commit server/.env to version control!
# =============================================================================

# --- Server Core Settings ---
PORT=4000
# Set to "production" on your hosting platform. In production the server REFUSES to boot
# with a missing/short JWT_SECRET or JWT_EXPIRES_IN=none.
NODE_ENV=development

# --- Optional Python AI classifier ---
# Local default is http://localhost:8001. For Render, set the deployed Python
# service URL and the same AI_SERVICE_TOKEN configured on that service.
# AI_SERVICE_URL=http://localhost:8001
# AI_SERVICE_TOKEN=generate-a-long-random-shared-secret
# AI_CLASSIFY_TIMEOUT_MS=8000

# Comma-separated list of frontend origins allowed to call the API + WebSocket server.
# Leave empty locally (allows everything). In production set it to your deployed frontend, e.g.
#   CORS_ORIGINS=https://srlms.vercel.app
CORS_ORIGINS=

# Number of reverse-proxy hops in front of the server (Render/Railway/Fly = 1). Needed so the
# rate limiter sees real client IPs.
TRUST_PROXY=1

# --- 1. MongoDB Database ---
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Or local: mongodb://127.0.0.1:27017/srlms
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/srlms?retryWrites=true&w=majority

# --- 2. Authentication & JWT ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_new_random_32_byte_hex_secret_here
# Token duration: 8h, 24h, 7d. 'none' (never expires) is for local testing only and is
# rejected when NODE_ENV=production.
JWT_EXPIRES_IN=8h

# --- 3. Razorpay Payment Gateway (Test Mode) ---
# Sign up free at https://dashboard.razorpay.com (toggle to Test Mode)
# Account & Settings -> API Keys -> Generate Key
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# --- 4. Python AI Microservice ---
# URL of the local FastAPI AI service (ai-service/main.py)
# Node server automatically falls back to local lexical matching if unreachable
AI_SERVICE_URL=http://localhost:8001

# --- 5. Twilio Real-Phone Calling (Voice PSTN) ---
# Sign up free at https://www.twilio.com/try-twilio
# Console Dashboard -> Account SID and Auth Token
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Your allocated Twilio phone number (Phone Numbers -> Active Numbers) in E.164 format:
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# The real phone number to transfer to when AI confidence is low.
# MUST be verified in Twilio Console -> Phone Numbers -> Verified Caller IDs during trial!
TWILIO_EXECUTIVE_FALLBACK_NUMBER=+91XXXXXXXXXX

# --- 6. Twilio WhatsApp Notifications ---
# Console -> Messaging -> Try it out -> Send a WhatsApp message
# Sandbox WhatsApp Number (default Twilio sandbox number or your allocated sandbox)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# The unique join code for your Twilio WhatsApp Sandbox (e.g. "join purple-tiger")
TWILIO_WHATSAPP_JOIN_CODE=join your-sandbox-word

# --- 7. Email Notifications (Resend API) ---
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# Resend's test sender works for testing. For passenger emails, verify a domain
# in Resend and use a sender address on that domain.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Sender display name:
EMAIL_FROM_NAME=Indian Railways SRLMS

# Recipient email for Emergency SOS alerts
# Supports comma-separated emails, e.g. "ops1@railway.gov,ops2@railway.gov"
SOS_ALERT_EMAIL=

# --- 8. Seeding (npm run seed) ---
# The seed script WIPES data. Against any non-local database (Atlas) it only runs when both of
# these are set. Pick a strong SEED_PASSWORD - it becomes the password of every demo account.
# Remove both variables again once you have seeded.
# ALLOW_SEED=true
# SEED_PASSWORD=choose-a-strong-password
