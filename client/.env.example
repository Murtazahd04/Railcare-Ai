# Frontend build-time variables (Vite). Copy to client/.env for local builds, or set them in
# your hosting dashboard (Vercel / Netlify / Cloudflare Pages) BEFORE building.
# They are baked into the JS bundle at build time -> never put secrets here.

# URL of the deployed backend (no trailing slash, no /api/v1). REQUIRED when the frontend and
# backend are on different hosts.
VITE_BACKEND_URL=https://your-backend.onrender.com

# Optional TURN relay so voice calls work on mobile data / strict Wi-Fi (see DEPLOYMENT.md).
# VITE_TURN_URL=turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
